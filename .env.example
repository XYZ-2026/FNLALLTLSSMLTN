# AI Counsellor (netlify/functions/cs-assistant) — set these in Netlify:
# Site configuration → Environment variables. Copy to .env for local runs (never commit .env).

# Required: OpenRouter API key
OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_CHAT_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free
# OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
# CS_PURCHASE_URL=https://www.conceptsimplified.in/courses
# CS_ALLOWED_ORIGINS=https://counselling.collegesimplified.in
# CS_ASSISTANT_BUDGET_MS=25000   # total time per answer; keep below your Netlify function timeout
# CS_RATE_LIMIT=25               # questions per IP per 10 minutes (per warm instance)
